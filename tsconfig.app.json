{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/vite-env.d.ts",
    "src/styles/theme.ts",
    "src/Features/LeadRoute/**/*",
    "src/routes/AppRoutes.tsx",
    "src/routes/RouteFallback.tsx",
    "src/routes/routeConfig.tsx",
    "src/types/route.types.ts",
    "src/constants/route.constants.ts",
    "src/constants/navigation.constants.ts",
    "src/constants/storage.constants.ts",
    "src/providers/ThemeProvider.tsx",
    "src/components/common/Toast/ToastProvider.tsx",
    "src/hooks/useAppDispatch.ts",
    "src/hooks/useAppSelector.ts",
    "src/hooks/index.ts",
    "src/redux/**/*",
    "src/utils/storage.utils.ts"
  ]
}
